# ─────────────────────────────────────────────────────────────────────────────
# PostLapAI environment template
#
# Copy to your deployment's secret store / .env and fill in real values.
# Do NOT commit real secrets.
#
# Production behaviour: when NODE_ENV=production and a required variable is
# missing, the API server throws at startup. Never deploy with the dev
# fallbacks (dev-secret / admin123).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
# Postgres connection string. The API server refuses to start without it.
DATABASE_URL=postgres://user:password@host:5432/dbname

# ── AI providers ─────────────────────────────────────────────────────────────
# Required for ad analysis (/api/check), Hamzawi chat, and text generation.
OPENAI_API_KEY=sk-...

# Optional for AI image generation (/api/image-gen). Falls back to
# NANO_BANANA_API_KEY if GEMINI_API_KEY is not set.
GEMINI_API_KEY=
NANO_BANANA_API_KEY=

# ── Google OAuth (REQUIRED for login/registration) ──────────────────────────
# OAuth 2.0 client ID from Google Cloud Console. Must match the audience used
# by the frontend Google Sign-In button. Baked into the frontend build.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# ── Auth secrets (REQUIRED in production) ────────────────────────────────────
# Used to sign JWTs and the hamzawi_session cookie. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=change-me-in-production

# Admin panel password for /api/admin/login.
# Generate with: openssl rand -base64 24
ADMIN_PASSWORD=change-me-in-production

# ── Runtime ──────────────────────────────────────────────────────────────────
# Port the API server binds (usually provided by the host platform).
PORT=5000
# NODE_ENV=production on the deployed API server.
NODE_ENV=development

# ── Frontend build-time (optional) ───────────────────────────────────────────
# When the frontend is served from a different origin than the API, set the
# absolute API origin here so /api/* calls are rewritten to it.
# VITE_API_BASE_URL=https://api.postlapai.com

# ── CORS (optional) ───────────────────────────────────────────────────────────
# Comma-separated list of extra origins allowed in production, on top of
# postlapai.com / www.postlapai.com. Same-origin requests are always allowed
# (required for the Replit frontend + API on one origin).
# CORS_ORIGINS=https://postlapai.replit.app

# ── Logging (optional) ───────────────────────────────────────────────────────
# LOG_LEVEL=fatal|error|warn|info|debug|trace
LOG_LEVEL=info
